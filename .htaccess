# =============================================================
# Sistem Manajemen Persuratan SMK - Apache (cPanel / Shared Hosting / Local)
# =============================================================
# Baris Options di-nonaktifkan karena sering memicu Error 500 pada shared hosting:
# Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Tolak akses langsung ke folder internal
    RewriteRule ^(application|system|vendor|database|storage)(/|$) - [F,L,NC]
    # Tolak file sensitif
    RewriteRule (^|/)(composer\.(json|lock)|README\.md|\.env|\.git) - [F,L,NC]

    # Teruskan semua request non-file ke index.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php/$1 [L,QSA]
</IfModule>
