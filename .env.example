# =============================================================================
# SISTEM MANAJEMEN PERSURATAN SEKOLAH - ENVIRONMENT VARIABLES
# =============================================================================
# Salin file ini menjadi .env jika diperlukan konfigurasi email SMTP,
# atau atur variabel lingkungan pada server (Apache / Nginx / Docker / Windows).

# Konfigurasi Database (Opsional: bisa diatur di sini atau di application/config/database.php)
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=db_persuratan_smk

# Konfigurasi SMTP (Contoh menggunakan Google Gmail / App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_CRYPTO=tls
SMTP_USER=persuratan.smk@gmail.com
SMTP_PASS=xxxx-xxxx-xxxx-xxxx
SMTP_FROM_EMAIL=persuratan.smk@gmail.com
SMTP_FROM_NAME="SMK Muhammadiyah Bandongan"

# Catatan Keamanan:
# 1. Jangan pernah commit file .env asli yang berisi kredensial ke Git repository.
# 2. Jika menggunakan Gmail, buat App Password 16 karakter melalui Google Account Security.
# 3. Jika variabel SMTP tidak diatur, sistem tetap berjalan normal dan notifikasi
#    disimpan secara andal di sistem notifikasi internal aplikasi (tanda lonceng).
